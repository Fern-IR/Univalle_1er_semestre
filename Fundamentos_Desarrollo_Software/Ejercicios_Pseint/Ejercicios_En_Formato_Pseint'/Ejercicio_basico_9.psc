Algoritmo Ejercicio_basico_9
	Escribir "Con while"
    contador <- 1
    Mientras contador <= 100 Hacer
        Si contador MOD 2 = 0 Entonces
            Escribir contador
        FinSi
        contador <- contador + 1
    FinMientras
	
    Escribir ""
	
    Para contador <- 1 Hasta 100 Con paso 1 Hacer
        Si contador MOD 2 = 0 Entonces
            Escribir contador
        FinSi
    FinPara
FinAlgoritmo
